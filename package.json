{
  "name": "autoresearch-rag",
  "type": "module",
  "private": true,
  "scripts": {
    "setup": "bun src/prepare.ts",
    "ingest": "bun src/ingest.ts",
    "ingest:quick": "bun src/ingest.ts --samples 500",
    "eval": "bun src/evaluate.ts",
    "eval:quick": "bun src/evaluate.ts --samples 100",
    "setup:bright": "bun src/prepare-bright.ts",
    "ingest:bright": "bun src/ingest-bright.ts",
    "ingest:bright:quick": "bun src/ingest-bright.ts --domain pony --force",
    "eval:bright": "bun src/evaluate-bright.ts",
    "eval:bright:quick": "bun src/evaluate-bright.ts --samples 20 --domain pony"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "postgres": "^3.4.7",
    "zod": "3.25"
  },
  "devDependencies": {
    "bun-types": "^1.3.11",
    "typescript": "^6.0.2"
  }
}
